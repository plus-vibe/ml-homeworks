# RustFS
RUSTFS_ACCESS_KEY=localdevaccess
RUSTFS_SECRET_KEY=change-this-to-a-unique-local-secret

# S3 access from host / WSL
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=ml-datasets
S3_API_PORT=9000
S3_CONSOLE_PORT=9001

# MLflow artifact bucket
MLFLOW_BUCKET=mlflow

# PostgreSQL (use an alphanumeric password)
POSTGRES_PASSWORD=change-this-to-a-unique-local-password
